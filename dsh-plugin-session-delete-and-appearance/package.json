{
  "name": "dsh-plugin-session-delete-and-appearance",
  "version": "0.1.0",
  "description": "Delete sessions straight from the DSH sidebar, plus a full appearance section: body/code/terminal font sizes and per-region color overrides. 在 DeepSeek Harness 侧栏直接删除会话，并提供完整的「外观定制」设置页。",
  "type": "module",
  "license": "MIT",
  "author": "__AUTHOR__",
  "icon": "assets/icon-180.png",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "session",
    "delete",
    "archive",
    "appearance",
    "theme",
    "font-size"
  ],
  "homepage": "https://github.com/__GITHUB_USER__/__REPO_NAME__#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/__GITHUB_USER__/__REPO_NAME__.git"
  },
  "bugs": {
    "url": "https://github.com/__GITHUB_USER__/__REPO_NAME__/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./assets/icon-180.png",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "assets/icon-180.png",
    "assets/icon-512.png",
    "locale",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
